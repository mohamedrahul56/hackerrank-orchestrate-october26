<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Anthropic" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="Tomlyn" />
  </ItemGroup>

  <ItemGroup>
    <!-- settings, prompts and the price template travel with the build output: the code reads them from next to the assembly -->
    <None Include="../../config/settings.toml" Link="config/settings.toml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../config/prices.example.json" Link="config/prices.example.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../prompts/*.md" Link="prompts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
